msgstr ""

#: scripts/main.gd:1495
msgid "A crown in row {row}, column {column} would rule out every open cell left in {group}, so cross it out."
msgstr ""

#. {a} and {b} are a row, column or region, e.g. "the purple region".
#: scripts/main.gd:1500
msgid "{a}'s open cells all lie in {b}, so {b}'s crown must come from {a}. Cross out the rest of {b}."
