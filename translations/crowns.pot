#: scripts/main.gd:1451
msgid "Cross out the cells the new crown rules out. (Auto-place × in Settings can do this for you.)"
msgstr ""

#: scripts/main.gd:1456
msgid "Double tap it to place a crown."
msgstr ""

#. {group} is a row, column or region, e.g. "row 3" or "the purple region".
#: scripts/main.gd:1489
msgid "{group} has only one cell left that can hold its crown."
msgstr ""

#: scripts/main.gd:1492
msgid "A crown in row {row}, column {column} would rule out every open cell left in {group}, so cross it out."
msgstr ""

#. {a} and {b} are a row, column or region, e.g. "the purple region".
#: scripts/main.gd:1497
msgid "{a}'s open cells all lie in {b}, so {b}'s crown must come from {a}. Cross out the rest of {b}."
msgstr ""

#. {a} and {b} are several rows, columns or regions, e.g. "rows 2 and 3"; {count} is at least 2.
#: scripts/main.gd:1500
msgid "{a} only have open cells in {b}, so their {count} crowns fill {b}. Cross out everything else in {b}."
