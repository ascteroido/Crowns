<?xml version="1.0" encoding="utf-8"?>
<!-- The widget when it's taller than wide (see Widget.java): today's board, then
     the title, size and difficulty, status and streak beneath it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/crowns_widget_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/crowns_widget_background"
	android:gravity="center_horizontal"
	android:orientation="vertical"
	android:padding="10dp">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<ImageView
			android:id="@+id/crowns_widget_board"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scaleType="fitCenter"
			android:visibility="gone" />

		<ImageView
			android:id="@+id/crowns_widget_crown"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="12dp"
			android:scaleType="fitCenter"
			android:src="@drawable/crowns_widget_crown" />
	</FrameLayout>

	<TextView
		android:id="@+id/crowns_widget_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:ellipsize="end"
		android:maxLines="1"
		android:text="Daily puzzle"
		android:textColor="#FFF4F1EA"
		android:textSize="16sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/crowns_widget_detail"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:ellipsize="end"
		android:maxLines="1"
		android:textColor="#B3F4F1EA"
		android:textSize="13sp"
		android:visibility="gone" />

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<ImageView
			android:id="@+id/crowns_widget_check"
			android:layout_width="18dp"
			android:layout_height="18dp"
			android:layout_marginEnd="6dp"
			android:src="@drawable/crowns_widget_check"
			android:visibility="gone" />

		<TextView
			android:id="@+id/crowns_widget_status"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:text="Ready to play"
			android:textColor="#E6F4F1EA"
			android:textSize="14sp" />
	</LinearLayout>

	<TextView
		android:id="@+id/crowns_widget_streak"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:ellipsize="end"
		android:maxLines="1"
		android:textColor="#FFF4C542"
		android:textSize="13sp"
		android:visibility="gone" />
</LinearLayout>
