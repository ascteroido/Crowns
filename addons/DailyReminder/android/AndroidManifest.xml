<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="com.ascathelstan.crowns.reminder">

	<uses-sdk android:minSdkVersion="24" />

	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

	<application>
		<receiver
			android:name="com.ascathelstan.crowns.reminder.Reminder"
			android:exported="false">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>

		<!-- App icons. Each opens the game through Launch (see Launch.java), so
		     AppIcon.java can switch between them without closing the game. Godot's
		     own launcher entry is off, as the classic entry here replaces it. -->
		<activity
			android:name="com.ascathelstan.crowns.icon.Launch"
			android:theme="@android:style/Theme.Translucent.NoTitleBar"
			android:taskAffinity=""
			android:excludeFromRecents="true"
			android:noHistory="true"
			android:exported="false" />
		<activity-alias
			android:name="com.godot.game.GodotAppLauncher"
			android:enabled="false" />
		<activity-alias
			android:name="com.ascathelstan.crowns.icon.classic"
			android:targetActivity="com.ascathelstan.crowns.icon.Launch"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		<!-- Variants from tools/make_icons.gd, off until chosen. -->
		<activity-alias
			android:name="com.ascathelstan.crowns.icon.dark"
			android:targetActivity="com.ascathelstan.crowns.icon.Launch"
			android:icon="@mipmap/crowns_icon_dark"
			android:enabled="false"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		<activity-alias
			android:name="com.ascathelstan.crowns.icon.midnight"
			android:targetActivity="com.ascathelstan.crowns.icon.Launch"
			android:icon="@mipmap/crowns_icon_midnight"
			android:enabled="false"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		<activity-alias
			android:name="com.ascathelstan.crowns.icon.forest"
			android:targetActivity="com.ascathelstan.crowns.icon.Launch"
			android:icon="@mipmap/crowns_icon_forest"
			android:enabled="false"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		<activity-alias
			android:name="com.ascathelstan.crowns.icon.contrast"
			android:targetActivity="com.ascathelstan.crowns.icon.Launch"
			android:icon="@mipmap/crowns_icon_contrast"
			android:enabled="false"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
	</application>
</manifest>
